# Скопируйте в .env: cp .env.example .env
# Для docker compose менять ничего не нужно. Переменные ниже — для запуска
# api и воркера прямо на хосте (uv run ...), когда в compose только инфраструктура.

POSTGRES_DSN=postgresql+asyncpg://copilot:copilot@localhost:5432/copilot
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
TELEMETRY_PHOENIX_ENDPOINT=http://localhost:4317

# Локальный vLLM на CPU и Ollama с входом в облако (ollama signin).
LLM_LOCAL_BASE_URL=http://localhost:8000/v1
LLM_CLOUD_BASE_URL=http://localhost:11434/v1

# Если стандартный порт на хосте занят, поменяйте его здесь.
# POSTGRES_HOST_PORT=5432
# QDRANT_HOST_PORT=6333
# VLLM_HOST_PORT=8000
